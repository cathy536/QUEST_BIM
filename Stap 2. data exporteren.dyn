    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\n\r\nwasRun = IN[0]\r\nwasCancelled = IN[1]\r\n\r\nif wasCancelled:\r\n    OUT = \"Run geannuleerd\"\r\nelif wasRun:\r\n    OUT = \"Run gelukt\"\r\nelse:\r\n    OUT = \"Run afgebroken\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "045f55214786462b8ec513a0bb90e2d9",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "2b879b55b75e406da007fc9a39b1162a",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2c77ef0c63334a7e8952020cd43821c8",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ed4c441ce7234718a98033df1756ff95",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "c1c01465-8e50-416b-909a-d9902aa0780b",
      "FunctionType": "Graph",
      "Id": "63bc48f78f4e4509827aec48f1af17d6",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "1e9816436d264c56aa272f96f4ed75e7",
          "Name": "title",
          "Description": "Title of the UI.\n\nstring",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9fbbf97426e74aec9efa8826e90bc6be",
          "Name": "body",
          "Description": "Body text of the UI.\n\nstring",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6e82d37fa28b43899bbb1b9abfd159a4",
          "Name": "pass",
          "Description": "Data to pass through\n\nvar[]..[]\nDefault value : null",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "b8b77d4c61ba4812b9e2ebe45b4bf33e",
          "Name": "result",
          "Description": "Passed through data. If canceled, will be null.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Displays a message box with a title/body and OK/cancel button. If OK is selected, the third input's data will be passed through."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "1683ef6ec5da404b8f2a7955e6a35569",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "4eac4094d2944d2c9db3ee9a9d39b9d1",
          "Name": "",
          "Description": "Value of expression at line 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "\"Script resultaten\";"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference('System.Windows.Forms')\r\nclr.AddReference('System.Drawing')\r\nfrom System.Windows.Forms import *\r\nfrom System.Drawing import *\r\nfrom System.IO import File, MemoryStream\r\nfrom System import Convert\r\n\r\n# ---- INPUTS ----\r\ninput_data = IN[0]\r\nif hasattr(input_data, 'Keys'):\r\n    schedule_names = list(input_data.Keys)\r\nelse:\r\n    schedule_names = list(input_data) if input_data else []\r\n\r\nfp_input = IN[1]\r\nif hasattr(fp_input, 'FilePath'):\r\n    default_path = str(fp_input.FilePath)\r\nelif fp_input is not None:\r\n    default_path = str(fp_input)\r\nelse:\r\n    default_path = \"\"\r\n\r\ntoggle_default = IN[2] if IN[2] is not None else True\r\n\r\n# ---- HU LOGO ALS BASE64 (geen extern bestand nodig) ----\r\nLOGO_B64 = \"\"\r\n\r\n# ---- KLEUREN HU HUISSTIJL ----\r\nhu_blauw = Color.FromArgb(30, 170, 220)\r\nhu_rood  = Color.FromArgb(190, 30, 45)\r\n\r\n# ---- DYNAMISCHE HOOGTES ----\r\nitem_height   = 18\r\nmin_list_h    = 80\r\nmax_list_h    = 300\r\nlist_height   = max(min_list_h, min(max_list_h, len(schedule_names) * item_height + 10))\r\n\r\ny_sep_top     = 76\r\ny_title       = y_sep_top + 12\r\ny_lbl_list    = y_title + 30\r\ny_chk_all     = y_lbl_list + 22\r\ny_clb         = y_chk_all + 26\r\ny_fp_lbl      = y_clb + list_height + 16\r\ny_fp_txt      = y_fp_lbl + 22\r\ny_toggle      = y_fp_txt + 44\r\ny_sep_bot     = y_toggle + 44\r\ny_knoppen     = y_sep_bot + 18\r\nform_height   = y_knoppen + 60\r\n\r\n\r\n# ---- FORM ----\r\nform = Form()\r\nform.Text = \"Export schedule\"\r\nform.Width = 600\r\nform.Height = form_height + 60\r\nform.StartPosition = FormStartPosition.CenterScreen\r\nform.TopMost = True\r\nform.FormBorderStyle = FormBorderStyle.FixedDialog\r\nform.MaximizeBox = False\r\nform.BackColor = Color.White\r\nform.ForeColor = Color.FromArgb(30, 30, 30)\r\n\r\n# ---- STREEP LINKS ----\r\nhalf = form_height // 2\r\nstreep_blauw = Panel()\r\nstreep_blauw.Location = Point(0, 0)\r\nstreep_blauw.Size = Size(8, half)\r\nstreep_blauw.BackColor = hu_blauw\r\nform.Controls.Add(streep_blauw)\r\n\r\nstreep_rood = Panel()\r\nstreep_rood.Location = Point(0, half)\r\nstreep_rood.Size = Size(8, form_height - half)\r\nstreep_rood.BackColor = hu_rood\r\nform.Controls.Add(streep_rood)\r\n\r\n# ---- LOGO ----\r\ntry:\r\n    img_bytes = Convert.FromBase64String(LOGO_B64)\r\n    ms = MemoryStream(img_bytes)\r\n    logo_img = Image.FromStream(ms)\r\n    logo_box = PictureBox()\r\n    logo_box.Image = logo_img\r\n    logo_box.SizeMode = PictureBoxSizeMode.Zoom\r\n    logo_box.Location = Point(20, 12)\r\n    logo_box.Size = Size(160, 55)\r\n    logo_box.BackColor = Color.White\r\n    form.Controls.Add(logo_box)\r\nexcept:\r\n    lbl_logo = Label()\r\n    lbl_logo.Text = \"HOGESCHOOL UTRECHT\"\r\n    lbl_logo.ForeColor = hu_blauw\r\n    lbl_logo.Location = Point(20, 18)\r\n    lbl_logo.Size = Size(300, 22)\r\n    form.Controls.Add(lbl_logo)\r\n\r\n# ---- SCHEIDINGSLIJN BOVEN ----\r\nsep_top = Panel()\r\nsep_top.Location = Point(8, y_sep_top)\r\nsep_top.Size = Size(566, 1)\r\nsep_top.BackColor = Color.FromArgb(210, 210, 210)\r\nform.Controls.Add(sep_top)\r\n\r\n# ---- TITEL ----\r\nlbl_title = Label()\r\nlbl_title.Text = \"Export schedule\"\r\nlbl_title.Location = Point(20, y_title)\r\nlbl_title.Size = Size(540, 24)\r\nform.Controls.Add(lbl_title)\r\n\r\n# ---- SCHEDULE LABEL ----\r\nlbl_list = Label()\r\nlbl_list.Text = \"Schedule (selecteer een of meerdere)\"\r\nlbl_list.Location = Point(20, y_lbl_list)\r\nlbl_list.Size = Size(540, 18)\r\nlbl_list.ForeColor = Color.FromArgb(80, 80, 80)\r\nform.Controls.Add(lbl_list)\r\n\r\n# ---- ALLES SELECTEREN ----\r\nchk_all = CheckBox()\r\nchk_all.Text = \"Alles selecteren\"\r\nchk_all.ThreeState = True\r\nchk_all.Location = Point(20, y_chk_all)\r\nchk_all.Size = Size(540, 22)\r\nform.Controls.Add(chk_all)\r\n\r\n# ---- CHECKED LISTBOX ----\r\nclb = CheckedListBox()\r\nclb.Location = Point(20, y_clb)\r\nclb.Size = Size(550, list_height)\r\nclb.BackColor = Color.FromArgb(250, 250, 250)\r\nclb.ForeColor = Color.FromArgb(30, 30, 30)\r\nclb.BorderStyle = BorderStyle.FixedSingle\r\nclb.CheckOnClick = True\r\n\r\nfor item in schedule_names:\r\n    if hasattr(item, 'Name'):\r\n        clb.Items.Add(item.Name, False)\r\n    else:\r\n        clb.Items.Add(str(item), False)\r\n\r\nform.Controls.Add(clb)\r\n\r\n# ---- ALLES SELECTEREN LOGICA ----\r\ndef toggle_all(s, e):\r\n    check = chk_all.Checked\r\n    for i in range(clb.Items.Count):\r\n        clb.SetItemChecked(i, check)\r\n\r\nchk_all.CheckedChanged += toggle_all\r\n\r\ndef item_check(s, e):\r\n    all_checked = all(clb.GetItemChecked(i) for i in range(clb.Items.Count))\r\n    none_checked = not any(clb.GetItemChecked(i) for i in range(clb.Items.Count))\r\n    chk_all.CheckedChanged -= toggle_all\r\n    if all_checked:\r\n        chk_all.CheckState = CheckState.Checked\r\n    elif none_checked:\r\n        chk_all.CheckState = CheckState.Unchecked\r\n    else:\r\n        chk_all.CheckState = CheckState.Indeterminate\r\n    chk_all.CheckedChanged += toggle_all\r\n\r\nclb.ItemCheck += item_check\r\n\r\n# ---- FILEPATH ----\r\nlbl_fp = Label()\r\nlbl_fp.Text = \"Bestand recovery rate - Kies het excel bestand...\"\r\nlbl_fp.Location = Point(20, y_fp_lbl)\r\nlbl_fp.Size = Size(540, 18)\r\nlbl_fp.ForeColor = Color.FromArgb(80, 80, 80)\r\nform.Controls.Add(lbl_fp)\r\n\r\ntxt_path = TextBox()\r\ntxt_path.Text = default_path\r\ntxt_path.Location = Point(20, y_fp_txt)\r\ntxt_path.Size = Size(420, 26)\r\ntxt_path.BackColor = Color.FromArgb(250, 250, 250)\r\ntxt_path.BorderStyle = BorderStyle.FixedSingle\r\nform.Controls.Add(txt_path)\r\n\r\nbtn_browse = Button()\r\nbtn_browse.Text = \"...\"\r\nbtn_browse.Location = Point(450, y_fp_txt - 2)\r\nbtn_browse.Size = Size(120, 28)\r\nbtn_browse.BackColor = Color.FromArgb(230, 230, 230)\r\nbtn_browse.FlatStyle = FlatStyle.Flat\r\n\r\ndef browse_click(s, e):\r\n    ofd = OpenFileDialog()\r\n    ofd.Filter = \"Excel bestanden (*.xlsx;*.xls)|*.xlsx;*.xls|Alle bestanden (*.*)|*.*\"\r\n    if ofd.ShowDialog() == DialogResult.OK:\r\n        txt_path.Text = ofd.FileName\r\n\r\nbtn_browse.Click += browse_click\r\nform.Controls.Add(btn_browse)\r\n\r\n# ---- TOGGLE ----\r\nchk_toggle = CheckBox()\r\nchk_toggle.Text = \"Actief\"\r\nchk_toggle.Checked = toggle_default if isinstance(toggle_default, bool) else True\r\nchk_toggle.Location = Point(20, y_toggle)\r\nchk_toggle.Size = Size(200, 24)\r\nform.Controls.Add(chk_toggle)\r\n\r\n# ---- SCHEIDINGSLIJN ONDER ----\r\nsep_bot = Panel()\r\nsep_bot.Location = Point(8, y_sep_bot)\r\nsep_bot.Size = Size(566, 1)\r\nsep_bot.BackColor = Color.FromArgb(210, 210, 210)\r\nform.Controls.Add(sep_bot)\r\n\r\n# ---- KNOPPEN ----\r\nbtn_ok = Button()\r\nbtn_ok.Text = \"Exporteren\"\r\nbtn_ok.Size = Size(130, 36)\r\nbtn_ok.Location = Point(20, y_knoppen)\r\nbtn_ok.BackColor = hu_blauw\r\nbtn_ok.ForeColor = Color.White\r\nbtn_ok.FlatStyle = FlatStyle.Flat\r\nbtn_ok.DialogResult = DialogResult.OK\r\nform.Controls.Add(btn_ok)\r\n\r\nbtn_cancel = Button()\r\nbtn_cancel.Text = \"Annuleren\"\r\nbtn_cancel.Size = Size(130, 36)\r\nbtn_cancel.Location = Point(165, y_knoppen)\r\nbtn_cancel.BackColor = Color.FromArgb(230, 230, 230)\r\nbtn_cancel.FlatStyle = FlatStyle.Flat\r\nbtn_cancel.DialogResult = DialogResult.Cancel\r\nform.Controls.Add(btn_cancel)\r\n\r\nform.AcceptButton = btn_ok\r\nform.CancelButton = btn_cancel\r\n\r\n# ---- RESULTAAT ----\r\nwas_cancelled = True\r\nuser_inputs = None\r\n\r\nif form.ShowDialog() == DialogResult.OK:\r\n    was_cancelled = False\r\n    selected = [clb.Items[i] for i in range(clb.Items.Count) if clb.GetItemChecked(i)]\r\n    user_inputs = {\r\n        \"Schedules\": selected,\r\n        \"FilePath\":  txt_path.Text,\r\n        \"Toggle\":    chk_toggle.Checked\r\n    }\r\n\r\nOUT = [user_inputs, not was_cancelled, was_cancelled]",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
