          "Description": "Passed through data",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Tells the first input to wait for the second input to arrive, then passes on the first input. Really useful for scripts which have branching paths that rely on their outputs to carry each other forward.\r\n\r\nQuite a few custom packages have a 'passthrough' or 'waitfor' node. I use these all the time, so find it useful to have them contained in this package also."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\n\r\nimport clr\r\nimport sys\r\nimport re\r\n\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nimport openpyxl\r\nfrom openpyxl.styles import Font, PatternFill, Alignment\r\n\r\nalleSchedules = IN[0] if isinstance(IN[0], list) else [IN[0]]\r\ngeselecteerd  = IN[1] if isinstance(IN[1], list) else [IN[1]]\r\nfilePath      = IN[2]\r\nwasRun        = IN[3]\r\n\r\nif not wasRun:\r\n    OUT = \"Niet uitgevoerd\"\r\nelse:\r\n    doc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n    # Afvlakken als geneste lijst\r\n    raw = []\r\n    for item in alleSchedules:\r\n        if isinstance(item, list):\r\n            raw.extend(item)\r\n        else:\r\n            raw.append(item)\r\n\r\n    # Extraheer naam uit \"ScheduleView[Name = MaterialTakeoff, walls ]\"\r\n    geselecteerdeNamen = []\r\n    for s in geselecteerd:\r\n        tekst = str(s)\r\n        # Probeer naam uit ScheduleView object te halen\r\n        if hasattr(s, 'Name'):\r\n            geselecteerdeNamen.append(s.Name)\r\n        elif \"Name = \" in tekst:\r\n            naam = re.sub(r'[\\]\\)]+$', '', tekst.split(\"Name = \")[1]).strip()\r\n            geselecteerdeNamen.append(naam)\r\n        else:\r\n            geselecteerdeNamen.append(tekst.strip())\r\n\r\n    # Filter Revit objecten op geselecteerde namen\r\n    schedules = [s for s in raw if s.Name in geselecteerdeNamen]\r\n\r\n    # Tabbladnamen koppeling\r\n    tabMap = {\r\n        \"MaterialTakeoff, ceilings\":      \"Plafonds\",\r\n        \"MaterialTakeoff, columns\":       \"Kolommen\",\r\n        \"MaterialTakeoff, curtain walls\": \"Gevelpanelen\",\r\n        \"MaterialTakeoff, door\":          \"Deuren\",\r\n        \"MaterialTakeoff, floor\":         \"Vloeren\",\r\n        \"MaterialTakeoff, roofs\":         \"Daken\",\r\n        \"MaterialTakeoff, walls\":         \"Wanden\",\r\n        \"MaterialTakeoff, windows\":       \"Ramen\",\r\n        \"MaterialTakeoff, stairs\":        \"Trappen\",\r\n    }\r\n    herkomstNamen = list(tabMap.values())\r\n\r\n    # Categorieën\r\n    categorieen = {\r\n        \"Beton\":     [\"systeemvloer\", \"gewapend\", \"concrete\", \"prefab_beton\", \"beton_prefab\", \"cellenbeton\", \"f2_beton\", \"f4_cellenb\", \"beton\", \"cement\"],\r\n        \"Hout\":      [\"wood\", \"timber\", \"triplex\", \"hardhout\", \"vuren\", \"larikshout\", \"douglashout\", \"multiplex\", \"hsb\", \"hout\", \"mdf\", \"osb\"],\r\n        \"Isolatie\":  [\"insulation\", \"isolatie\", \"glaswol\", \"mineraalwol\", \"steenwol\", \"eps\", \"xps\", \"pur\", \"pir\"],\r\n        \"Staal\":     [\"steel\", \"staal\", \"metaal\", \"zink\", \"verzinkt\", \"galvanized\"],\r\n        \"Bitumen\":   [\"bitumen\", \"bitumineus\", \"roofing\", \"dakbedekking\", \"dakleer\", \"sbs\", \"app\"],\r\n        \"Koper\":     [\"koper\", \"copper\"],\r\n        \"Aluminium\": [\"aluminium\", \"alu\", \"aluminum\"],\r\n        \"Keramiek\":  [\"_mw_\", \"halfst\", \"koppen\", \"verband\", \"kalkzandsteen\", \"keramiek\", \"keramisch\", \"ceramic\", \"tegel\", \"tegelwerk\", \"dakpan\", \"dakpannen\"],\r\n        \"Afwerking\": [\"stucwerk\", \"spuitwerk\", \"gips\", \"verf\", \"coating\"],\r\n        \"Overig\":    []\r\n    }\r\n\r\n    def get_categorie(naam):\r\n        naam_lower = naam.lower()\r\n        for cat, keywords in categorieen.items():\r\n            if cat == \"Overig\":\r\n                continue\r\n            for kw in keywords:\r\n                if kw in naam_lower:\r\n                    return cat\r\n        return \"Overig\"\r\n\r\n    def parse_volume(waarde):\r\n        if waarde is None:\r\n            return 0.0\r\n        tekst = str(waarde).strip()\r\n        tekst = tekst.replace(\"m³\", \"\").replace(\"m3\", \"\").strip()\r\n        tekst = tekst.replace(\",\", \".\")\r\n        tekst = re.sub(r'\\.(?=\\d{3})', '', tekst)\r\n        try:\r\n            return float(tekst)\r\n        except:\r\n            return 0.0\r\n\r\n    # Stap 1: data uitlezen uit Revit schedules\r\n    data = {cat: {h: 0.0 for h in herkomstNamen} for cat in categorieen}\r\n    detailData = {cat: [] for cat in categorieen}\r\n\r\n    for schedule in schedules:\r\n        schedName     = schedule.Name\r\n        herkomst      = tabMap.get(schedName, schedName)\r\n        revitSchedule = schedule.InternalElement\r\n\r\n        tableData   = revitSchedule.GetTableData()\r\n        sectionData = tableData.GetSectionData(SectionType.Body)\r\n        rows        = sectionData.NumberOfRows\r\n        cols        = sectionData.NumberOfColumns\r\n\r\n        # Zoek kolom indices op basis van header rij\r\n        matNaamCol = None\r\n        matVolCol  = None\r\n        for c in range(cols):\r\n            header = revitSchedule.GetCellText(SectionType.Body, 0, c).strip()\r\n            if \"Material: Name\" in header or \"Materiaal\" in header:\r\n                matNaamCol = c\r\n            if \"Material: Volume\" in header or \"Volume\" in header:\r\n                matVolCol = c\r\n\r\n        if matNaamCol is None or matVolCol is None:\r\n            continue\r\n\r\n        for r in range(1, rows):\r\n            matNaam = revitSchedule.GetCellText(SectionType.Body, r, matNaamCol).strip()\r\n            matVol  = revitSchedule.GetCellText(SectionType.Body, r, matVolCol).strip()\r\n\r\n            if not matNaam or matNaam in [\"<varies>\"] or matNaam.startswith(\"<\"):\r\n                continue\r\n\r\n            volume = parse_volume(matVol)\r\n            if volume == 0.0:\r\n                continue\r\n\r\n            cat = get_categorie(matNaam)\r\n\r\n            data[cat][herkomst] += volume\r\n\r\n            # DETAIL REGEL OPSLAAN (nieuw)\r\n            detailData[cat].append([\r\n                herkomst,\r\n                volume,\r\n                matNaam,\r\n                schedName,\r\n            ])\r\n\r\n    # Stap 2: Excel opbouwen\r\n    wb = openpyxl.load_workbook(filePath)\r\n\r\n    # Stijlen\r\n    headerFont  = Font(bold=True, color=\"FFFFFF\")\r\n    headerFill  = PatternFill(\"solid\", fgColor=\"196B24\")\r\n    totaalFont  = Font(bold=True)\r\n    totaalFill  = PatternFill(\"solid\", fgColor=\"C1F0C8\")\r\n    centerAlign = Alignment(horizontal=\"center\")\r\n\r\n    # Stap 3: per categorie de waarden overschrijven\r\n    categorieTabs = []\r\n    for cat in categorieen:\r\n        volumes = data[cat]\r\n        tabNaam = cat + \"-data\"\r\n        categorieTabs.append(tabNaam)\r\n\r\n        if tabNaam not in wb.sheetnames:\r\n            ws = wb.create_sheet(tabNaam)\r\n        else:\r\n            ws = wb[tabNaam]\r\n\r\n        # ── Altijd: header + totaalrij + volumedata schrijven ──\r\n        ws[\"A1\"] = \"Herkomst\"\r\n        ws[\"B1\"] = \"Volume (m³)\"\r\n        for cel in [\"A1\", \"B1\"]:\r\n            ws[cel].font      = headerFont\r\n            ws[cel].fill      = headerFill\r\n            ws[cel].alignment = centerAlign\r\n        ws[\"A2\"] = \"Totaal\"\r\n        ws[\"B2\"] = f\"=SUM(B3:B{2 + len(herkomstNamen)})\"\r\n        ws[\"A2\"].font = totaalFont\r\n        ws[\"B2\"].font = totaalFont\r\n        ws[\"A2\"].fill = totaalFill\r\n        ws[\"B2\"].fill = totaalFill\r\n        for i, herkomst in enumerate(herkomstNamen):\r\n            rij = i + 3\r\n            ws[f\"A{rij}\"] = herkomst\r\n            ws[f\"B{rij}\"] = round(volumes[herkomst], 2)\r\n        ws.column_dimensions[\"A\"].width = 20\r\n        ws.column_dimensions[\"B\"].width = 15\r\n        ws.column_dimensions[\"C\"].width = 35\r\n        ws.column_dimensions[\"D\"].width = 35\r\n\r\n        # ── Altijd: detailtabel schrijven (overschrijft vorige inhoud) ──\r\n        startRow = len(herkomstNamen) + 6\r\n\r\n        ws.cell(startRow, 1).value = \"DETAIL REGELS (bron: schedules)\"\r\n        ws.cell(startRow, 1).font  = headerFont\r\n\r\n        headers = [\"Herkomst\", \"Volume\", \"Materiaal\", \"Schedule\"]\r\n        for i, h in enumerate(headers):\r\n            c = ws.cell(startRow + 1, i + 1)\r\n            c.value     = h\r\n            c.font      = headerFont\r\n            c.fill      = headerFill\r\n            c.alignment = centerAlign\r\n\r\n        for i, row in enumerate(detailData[cat]):\r\n            r = startRow + 2 + i\r\n            ws.cell(r, 1).value = row[0]          # herkomst\r\n            ws.cell(r, 2).value = round(row[1], 3) # volume\r\n            ws.cell(r, 3).value = row[2]           # materiaal\r\n            ws.cell(r, 4).value = row[3]           # schedule\r\n\r\n        # Altijd volledige inhoud en opmaak schrijven\r\n        ws[\"A1\"] = \"Herkomst\"\r\n        ws[\"B1\"] = \"Volume (m³)\"\r\n        for cel in [\"A1\", \"B1\"]:\r\n            ws[cel].font      = headerFont\r\n            ws[cel].fill      = headerFill\r\n            ws[cel].alignment = centerAlign\r\n        ws[\"A2\"] = \"Totaal\"\r\n        ws[\"B2\"] = f\"=SUM(B3:B{2 + len(herkomstNamen)})\"\r\n        ws[\"A2\"].font = totaalFont\r\n        ws[\"B2\"].font = totaalFont\r\n        ws[\"A2\"].fill = totaalFill\r\n        ws[\"B2\"].fill = totaalFill\r\n        for i, herkomst in enumerate(herkomstNamen):\r\n            rij = i + 3\r\n            ws[f\"A{rij}\"] = herkomst\r\n            ws[f\"B{rij}\"] = round(volumes[herkomst], 2)\r\n        ws.column_dimensions[\"A\"].width = 20\r\n        ws.column_dimensions[\"B\"].width = 15\r\n        ws.column_dimensions[\"C\"].width = 35\r\n        ws.column_dimensions[\"D\"].width = 35\r\n        \r\n    # Stap 4: Samenvatting tabblad\r\n    if \"Samenvatting-data\" not in wb.sheetnames:\r\n        ws_sam = wb.create_sheet(\"Samenvatting-data\", 2)\r\n        ws_sam[\"A1\"] = \"Categorie\"\r\n        ws_sam[\"B1\"] = \"Volume (m³)\"\r\n        for cel in [\"A1\", \"B1\"]:\r\n            ws_sam[cel].font      = headerFont\r\n            ws_sam[cel].fill      = headerFill\r\n            ws_sam[cel].alignment = centerAlign\r\n        ws_sam[\"A2\"] = \"Totaal\"\r\n        ws_sam[\"B2\"] = f\"=SUM(B3:B{2 + len(categorieTabs)})\"\r\n        ws_sam[\"A2\"].font = totaalFont\r\n        ws_sam[\"B2\"].font = totaalFont\r\n        ws_sam[\"A2\"].fill = totaalFill\r\n        ws_sam[\"B2\"].fill = totaalFill\r\n        for i, tabNaam in enumerate(categorieTabs):\r\n            rij = i + 3\r\n            ws_sam[f\"A{rij}\"] = tabNaam.replace(\"-data\", \"\")\r\n            ws_sam[f\"B{rij}\"] = f\"='{tabNaam}'!B2\"\r\n        ws_sam.column_dimensions[\"A\"].width = 20\r\n        ws_sam.column_dimensions[\"B\"].width = 15\r\n    else:\r\n        ws_sam = wb[\"Samenvatting-data\"]\r\n        for i, tabNaam in enumerate(categorieTabs):\r\n            rij = i + 3\r\n            ws_sam[f\"B{rij}\"] = f\"='{tabNaam}'!B2\"\r\n\r\n    wb.save(filePath)\r\n    OUT = \"Klaar! Tabbladen bijgewerkt: Samenvatting + \" + \", \".join(categorieTabs)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "8327caab4e1f4dbfb57184c2def8a0a0",
